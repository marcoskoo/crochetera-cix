# === Vercel Postgres ===
# Railway/Vercel inyecta DATABASE_URL automáticamente al crear PostgreSQL
# Para desarrollo local, crea una DB en https://vercel.com/dashboard/stores
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# === Vercel Blob Storage ===
# Crear en: https://vercel.com/dashboard/stores (Blob Store)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# === Opcional ===
NEXT_TELEMETRY_DISABLED=1
